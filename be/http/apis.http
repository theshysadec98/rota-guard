### Rota Guard BE (base :8080)
@baseUrl = http://localhost:8080/api/v1
@demoWeek = 2025-05-12
@testWeek = 2025-06-09
@runId = 1

### Health
GET {{baseUrl}}/health

### Policies
GET {{baseUrl}}/policies

### Create policy
POST {{baseUrl}}/policies
Content-Type: application/json

{
  "name": "HTTP Test Policy",
  "department": "ICU",
  "minRestHours": 11,
  "maxConsecutiveNights": 2,
  "maxWeeklyHours": 60,
  "churnThreshold": 60
}

### Staff search
GET {{baseUrl}}/staff?q=nguyen&page=0&size=20&sort=name&dir=asc

### Create staff
POST {{baseUrl}}/staff
Content-Type: application/json

{
  "name": "HTTP Nurse",
  "role": "NURSE",
  "department": "ICU",
  "sensitivityFactor": 1.0
}

### Update staff
PUT {{baseUrl}}/staff/1
Content-Type: application/json

{
  "name": "Nguyen Thi Lan",
  "role": "NURSE",
  "department": "ICU",
  "sensitivityFactor": 1.0
}

### Staff import JSON
POST {{baseUrl}}/staff/import
Content-Type: application/json

{
  "staff": [
    {
      "name": "HTTP Import",
      "role": "NURSE",
      "department": "ICU",
      "sensitivityFactor": 1.0
    }
  ]
}

### Shifts list (demo week)
GET {{baseUrl}}/shifts?weekStart={{demoWeek}}

### Week board (3x7 grid)
GET {{baseUrl}}/shifts/week-board?weekStart={{demoWeek}}

### Delete single shift
DELETE {{baseUrl}}/shifts/1

### Shifts import JSON (+07:00)
POST {{baseUrl}}/shifts/import
Content-Type: application/json

{
  "weekStart": "{{testWeek}}",
  "replaceWeek": true,
  "shifts": [
    {
      "staffId": 1,
      "startAt": "2025-06-09T22:00:00+07:00",
      "endAt": "2025-06-10T06:00:00+07:00",
      "shiftType": "NIGHT"
    }
  ]
}

### Reassign shift
POST {{baseUrl}}/shifts/1/reassign
Content-Type: application/json

{
  "newStaffId": 2
}

### Run analysis
POST {{baseUrl}}/analysis/run?weekStart={{demoWeek}}&policyId=1

### Report
GET {{baseUrl}}/analysis/{{runId}}/report

### Staff risk
GET {{baseUrl}}/staff/1/risk?runId={{runId}}

### Policy diff
POST {{baseUrl}}/analysis/policy-diff
Content-Type: application/json

{
  "weekStart": "{{demoWeek}}",
  "policyIdA": 1,
  "policyIdB": 2
}

### What-if
POST {{baseUrl}}/analysis/what-if
Content-Type: application/json

{
  "weekStart": "{{demoWeek}}",
  "policyId": 1,
  "shiftChanges": [
    { "shiftId": 2, "newStaffId": 2 }
  ]
}

### Suggestions
POST {{baseUrl}}/analysis/suggestions
Content-Type: application/json

{
  "weekStart": "{{demoWeek}}",
  "policyId": 1,
  "runId": {{runId}},
  "targetRiskLevels": ["RED"],
  "maxSuggestions": 10
}

### Invalid weekStart (expect 400)
GET {{baseUrl}}/shifts?weekStart=2025-06-10
